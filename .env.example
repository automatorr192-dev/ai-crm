# Ключ OpenRouter (openrouter.ai -> Keys)
OPENROUTER_API_KEY=

# Модели через запятую — берём по очереди, пока одна не ответит.
MODELS=deepseek/deepseek-v4-flash,nvidia/nemotron-3-super-120b-a12b:free

# Доступ в админку. Без них админка отдаёт 503: в заявках персональные данные,
# открывать их всему интернету нельзя.
ADMIN_USER=
ADMIN_PASSWORD=

# Куда класть базу. По умолчанию /data — том, переживающий передеплой на Amvera.
DATA_DIR=/data
