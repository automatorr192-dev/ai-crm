# Ключ OpenRouter (openrouter.ai -> Keys)
OPENROUTER_API_KEY=

# Модели через запятую — берём по очереди, пока одна не ответит.
MODELS=deepseek/deepseek-v4-flash,nvidia/nemotron-3-super-120b-a12b:free

# Первый вход в пустую систему: из этой пары заводится владелец, если сотрудников ещё
# нет. Дальше люди добавляются на экране «Команда», а пароли лежат в базе хешами.
ADMIN_USER=
ADMIN_PASSWORD=

# Ключ, которым подписываются сессии. Сгенерировать: python -c "import secrets;
# print(secrets.token_hex(32))". Пусто — ключ случайный на время жизни процесса,
# и все пользователи выходят из системы при каждом перезапуске.
SESSION_SECRET=

# Сколько дней живёт вход без повторного пароля.
SESSION_DAYS=14

# Общий секрет с тем, кто шлёт заявки по вебхуку (бот, интеграция, чужая CMS).
# Пусто — этот вход закрыт. К публичной форме на сайте отношения не имеет: она ничего
# подписать не может, там работают CORS, потолок с адреса и ловушка для ботов.
WEBHOOK_SECRET=

# Домены, с которых браузеру разрешено слать заявки в /api/public/lead. Через запятую,
# со схемой: https://automatorr192-dev.github.io. Пусто — публичная форма с другого
# домена работать не будет (звёздочка тут означала бы «любая страница в интернете»).
ALLOWED_ORIGINS=

# Чем помечаются заявки с публичной формы: этим источником они видны в отчёте.
PUBLIC_SOURCE=сайт

# Сколько заявок с одного адреса принимает публичная форма за час.
PUBLIC_PER_HOUR=10

# Окно в секундах, внутри которого одинаковая заявка считается повтором, а не новой.
DEDUPE_SECONDS=300

# Пароль базы для docker-compose. Postgres поднимается рядом, наружу не торчит.
POSTGRES_PASSWORD=

# Адрес базы. Пусто — локальный sqlite в DATA_DIR. В облаке сюда строка от Postgres.
DATABASE_URL=

# Куда класть файлы. По умолчанию /data — том, переживающий передеплой на Amvera.
DATA_DIR=/data

# Ассистент-квалификатор в Telegram. Токен от @BotFather и имя бота без @.
# Пусто — ассистент выключен, форма на сайте просто принимает заявку.
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# Модели ассистента через запятую. Нужна поддержка вызова инструментов (tool calling).
AGENT_MODELS=anthropic/claude-haiku-4.5,deepseek/deepseek-v4-flash

# Пусто — Sentry выключен, ошибки остаются только в логах.
SENTRY_DSN=

# Уведомления команде в Telegram: id чатов через запятую. Добавьте бота в чат отдела
# продаж и напишите там /id — бот ответит номером. Пусто — уведомления выключены.
NOTIFY_CHAT_IDS=
# Адрес CRM для кнопки «Открыть в CRM» в уведомлениях, только https.
PUBLIC_URL=
# Как часто проверять сроки по сделкам, в секундах.
REMIND_EVERY_SECONDS=60
# Во сколько по Москве присылать утреннюю сводку: новые, просроченные, без движения.
DIGEST_HOUR=9
# Через сколько дней без единого действия сделка считается «без движения».
STALE_DAYS=3

# Публичная форма принимает заявку только с галочкой согласия на обработку данных.
CONSENT_REQUIRED=1

# Вход для Тильды, Contact Form 7 и любых форм с вебхуком: https://crm/hook/<токен>.
# Пусто — вход закрыт. Сгенерировать так же, как SESSION_SECRET.
INTAKE_TOKEN=

# Дублировать заявки во внешнюю CRM клиента. Битрикс24: адрес входящего вебхука
# с правом crm, вида https://портал.bitrix24.ru/rest/1/код
BITRIX24_WEBHOOK=
# amoCRM: поддомен и долгосрочный токен приватной интеграции, воронка — по желанию.
AMOCRM_SUBDOMAIN=
AMOCRM_TOKEN=
AMOCRM_PIPELINE_ID=

# Ночная копия базы в DATA_DIR/backups: сколько хранить и во сколько снимать (МСК).
# BACKUP_KEEP=0 выключает.
BACKUP_KEEP=14
BACKUP_HOUR=3

# Потолок размера файла в карточке сделки, МБ.
MAX_FILE_MB=10

# Шапка и условия коммерческого предложения из карточки сделки. Условия через «|».
COMPANY_NAME=
COMPANY_DETAILS=
COMPANY_CONTACT=
OFFER_TERMS=
OFFER_DAYS=14

# Демо для портфолио: тестовые клиенты и сделки, вход в один клик, сброс каждую ночь.
DEMO_MODE=
DEMO_RESET_HOUR=4
