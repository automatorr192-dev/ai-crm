# Ключ OpenRouter (openrouter.ai -> Keys)
OPENROUTER_API_KEY=

# Модели через запятую — берём по очереди, пока одна не ответит.
MODELS=deepseek/deepseek-v4-flash,nvidia/nemotron-3-super-120b-a12b:free

# Первый вход в пустую систему: из этой пары заводится владелец, если сотрудников ещё
# нет. Дальше люди добавляются на экране «Команда», а пароли лежат в базе хешами.
ADMIN_USER=
ADMIN_PASSWORD=

# Ключ, которым подписываются сессии. Сгенерировать: python -c "import secrets;
# print(secrets.token_hex(32))". Пусто — ключ случайный на время жизни процесса,
# и все пользователи выходят из системы при каждом перезапуске.
SESSION_SECRET=

# Сколько дней живёт вход без повторного пароля.
SESSION_DAYS=14

# Общий секрет с тем, кто шлёт заявки по вебхуку (бот, интеграция, чужая CMS).
# Пусто — этот вход закрыт. К публичной форме на сайте отношения не имеет: она ничего
# подписать не может, там работают CORS, потолок с адреса и ловушка для ботов.
WEBHOOK_SECRET=

# Домены, с которых браузеру разрешено слать заявки в /api/public/lead. Через запятую,
# со схемой: https://automatorr192-dev.github.io. Пусто — публичная форма с другого
# домена работать не будет (звёздочка тут означала бы «любая страница в интернете»).
ALLOWED_ORIGINS=

# Чем помечаются заявки с публичной формы: этим источником они видны в отчёте.
PUBLIC_SOURCE=сайт

# Сколько заявок с одного адреса принимает публичная форма за час.
PUBLIC_PER_HOUR=10

# Окно в секундах, внутри которого одинаковая заявка считается повтором, а не новой.
DEDUPE_SECONDS=300

# Пароль базы для docker-compose. Postgres поднимается рядом, наружу не торчит.
POSTGRES_PASSWORD=

# Адрес базы. Пусто — локальный sqlite в DATA_DIR. В облаке сюда строка от Postgres.
DATABASE_URL=

# Куда класть файлы. По умолчанию /data — том, переживающий передеплой на Amvera.
DATA_DIR=/data

# Пусто — Sentry выключен, ошибки остаются только в логах.
SENTRY_DSN=
