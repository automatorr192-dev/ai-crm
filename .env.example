# Ключ OpenRouter (openrouter.ai -> Keys)
OPENROUTER_API_KEY=

# Модели через запятую — берём по очереди, пока одна не ответит.
MODELS=deepseek/deepseek-v4-flash,nvidia/nemotron-3-super-120b-a12b:free

# Доступ в админку. Без них админка отдаёт 503: в заявках персональные данные,
# открывать их всему интернету нельзя.
ADMIN_USER=
ADMIN_PASSWORD=

# Общий секрет с тем, кто шлёт заявки (форма, квиз, чужой сервис). Пусто — приём закрыт.
WEBHOOK_SECRET=

# Пароль базы для docker-compose. Postgres поднимается рядом, наружу не торчит.
POSTGRES_PASSWORD=

# Адрес базы. Пусто — локальный sqlite в DATA_DIR. В облаке сюда строка от Postgres.
DATABASE_URL=

# Куда класть файлы. По умолчанию /data — том, переживающий передеплой на Amvera.
DATA_DIR=/data

# Пусто — Sentry выключен, ошибки остаются только в логах.
SENTRY_DSN=
